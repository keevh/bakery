{
  "name": "bakery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "sh -c 'docker compose up -d postgres && until docker compose exec -T postgres pg_isready -U postgres -d bakery >/dev/null 2>&1; do sleep 1; done'",
    "db:stop": "docker compose down",
    "db:bootstrap": "node --import tsx ./src/scripts/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
